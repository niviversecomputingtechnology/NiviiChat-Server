NODE_ENV=development

# Postgres (matches docker-compose service "db")
POSTGRES_USER=nivichat
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nivichat
DATABASE_URL=postgresql://nivichat:change_me@db:5432/nivichat?schema=public

# Auth
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=30d

# App
APP_VERSION=2.0.11
API_PORT=3000
WS_PORT=8080

# Push (referenced by client's ONESIGNAL_ID — keep out of source, inject here)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
